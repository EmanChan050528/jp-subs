# Text is stored and checked out with LF on every platform, so Windows'
# core.autocrlf stops warning on every commit. Chrome, Node and the fixtures
# all read LF fine.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Never touch these (extension icons, fonts, media).
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.mp3   binary
*.mp4   binary
